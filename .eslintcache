nfig":"24"},{"size":1167,"mtime":1787208507100,"results":"44","hashOfConfig":"24"},{"size":3279,"mtime":1787208507111,"results":"45","hashOfConfig":"24"},{"filePath":"46","messages":"47","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},"wam5fs",{"filePath":"49","messages":"50","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},{"filePath":"51","messages":"52","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},{"filePath":"53","messages":"54","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"55","usedDeprecatedRules":"48"},{"filePath":"56","messages":"57","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},{"filePath":"58","messages":"59","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"60"},{"filePath":"61","messages":"62","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},{"filePath":"63","messages":"64","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},{"filePath":"65","messages":"66","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},{"filePath":"67","messages":"68","errorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"69","usedDeprecatedRules":"48"},{"filePath":"70","messages":"71","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"60"},{"filePath":"72","messages":"73","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"60"},{"filePath":"74","messages":"75","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"76","usedDeprecatedRules":"48"},{"filePath":"77","messages":"78","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"60"},{"filePath":"79","messages":"80","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},{"filePath":"81","messages":"82","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"60"},{"filePath":"83","messages":"84","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"60"},{"filePath":"85","messages":"86","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},{"filePath":"87","messages":"88","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"89","messages":"90","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},{"filePath":"91","messages":"92","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},{"filePath":"93","messages":"94","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"95"},"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\index.js",[],["96","97"],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\reportWebVitals.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\App.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\Logout.js",["98"],"import { useEffect, useContext } from \"react\";\nimport { Redirect } from \"react-router-dom\";\n\nimport { SetPopupContext } from \"../App\";\n\nconst Logout = (props) => {\n  const setPopup = useContext(SetPopupContext);\n  useEffect(() => {\n    localStorage.removeItem(\"token\");\n    localStorage.removeItem(\"type\");\n    setPopup({\n      open: true,\n      severity: \"success\",\n      message: \"Logged out successfully\",\n    });\n  }, []);\n  return <Redirect to=\"/login\" />;\n};\n\nexport default Logout;\n","C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\Welcome.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\Signup.js",[],["99","100"],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\Navbar.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\Login.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\Home.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\Applications.js",["101","102","103","104","105"],"import { useState, useEffect, useContext } from \"react\";\nimport {\n  Button,\n  Chip,\n  Grid,\n  makeStyles,\n  Paper,\n  Typography,\n  Box,\n  Avatar,\n  Divider,\n} from \"@material-ui/core\";\nimport axios from \"axios\";\nimport BusinessCenterIcon from \"@material-ui/icons/BusinessCenter\";\nimport AccessTimeIcon from \"@material-ui/icons/AccessTime\";\nimport MonetizationOnIcon from \"@material-ui/icons/MonetizationOn\";\nimport DescriptionIcon from \"@material-ui/icons/Description\";\n\nimport { SetPopupContext } from \"../App\";\nimport apiList from \"../lib/apiList\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    backgroundColor: \"#f4f6f9\",\n    minHeight: \"100vh\",\n    padding: \"40px 20px 80px 20px\",\n    fontFamily: \"'Inter', -apple-system, BlinkMacSystemFont, sans-serif\",\n  },\n  headerBanner: {\n    background: \"linear-gradient(135deg, #0f172a 0%, #1e293b 100%)\",\n    borderRadius: \"20px\",\n    padding: \"35px 30px\",\n    color: \"#fff\",\n    marginBottom: \"30px\",\n    boxShadow: \"0 10px 25px rgba(0,0,0,0.1)\",\n  },\n  appCard: {\n    borderRadius: \"16px\",\n    padding: \"24px\",\n    backgroundColor: \"#ffffff\",\n    border: \"1px solid #e2e8f0\",\n    boxShadow: \"0 4px 15px rgba(0,0,0,0.03)\",\n    marginBottom: \"18px\",\n    transition: \"transform 0.2s ease\",\n    \"&:hover\": {\n      transform: \"translateY(-2px)\",\n      borderColor: \"#3b82f6\",\n    },\n  },\n  statusApplied: { backgroundColor: \"#fef3c7\", color: \"#b45309\", fontWeight: 700 },\n  statusShortlisted: { backgroundColor: \"#dbeafe\", color: \"#1d4ed8\", fontWeight: 700 },\n  statusAccepted: { backgroundColor: \"#dcfce7\", color: \"#15803d\", fontWeight: 700 },\n  statusRejected: { backgroundColor: \"#fee2e2\", color: \"#b91c1c\", fontWeight: 700 },\n}));\n\nconst mockApplications = [\n  {\n    _id: \"app_1\",\n    job: {\n      title: \"Technology Strategy & Enterprise Architecture Intern\",\n      recruiter: { name: \"KPMG Advisory Practice\" },\n      salary: 50000,\n      duration: 6,\n    },\n    status: \"shortlisted\",\n    dateOfApplication: new Date(Date.now() - 3 * 24 * 60 * 60 * 1000).toISOString(),\n    sop: \"Focused on leveraging cloud architecture and business consulting frameworks to optimize enterprise systems.\",\n  },\n  {\n    _id: \"app_2\",\n    job: {\n      title: \"Management Consulting & Strategic Transformation Intern\",\n      recruiter: { name: \"Apex Advisory Group\" },\n      salary: 45000,\n      duration: 3,\n    },\n    status: \"applied\",\n    dateOfApplication: new Date(Date.now() - 6 * 24 * 60 * 60 * 1000).toISOString(),\n    sop: \"Extensive background in market entry models, financial valuation, and cross-functional technology strategy.\",\n  },\n];\n\nconst Applications = () => {\n  const classes = useStyles();\n  const [applications, setApplications] = useState([]);\n  const setPopup = useContext(SetPopupContext);\n\n  useEffect(() => {\n    fetchApplications();\n  }, []);\n\n  const fetchApplications = () => {\n    axios\n      .get(apiList.applications, {\n        headers: { Authorization: `Bearer ${localStorage.getItem(\"token\")}` },\n      })\n      .then((response) => {\n        if (response.data && response.data.length > 0) {\n          setApplications(response.data);\n        } else {\n          setApplications(mockApplications); // Fallback to realistic preview data\n        }\n      })\n      .catch(() => {\n        setApplications(mockApplications);\n      });\n  };\n\n  const getStatusChip = (status) => {\n    switch (status?.toLowerCase()) {\n      case \"shortlisted\":\n        return <Chip label=\"Shortlisted for Review\" className={classes.statusShortlisted} size=\"small\" />;\n      case \"accepted\":\n        return <Chip label=\"Offer Accepted\" className={classes.statusAccepted} size=\"small\" />;\n      case \"rejected\":\n        return <Chip label=\"Not Selected\" className={classes.statusRejected} size=\"small\" />;\n      default:\n        return <Chip label=\"Application Submitted\" className={classes.statusApplied} size=\"small\" />;\n    }\n  };\n\n  return (\n    <Box className={classes.root}>\n      <Grid container justify=\"center\">\n        <Grid item xs={11} md={8}>\n          {/* Top Banner */}\n          <Box className={classes.headerBanner}>\n            <Typography variant=\"h4\" style={{ fontWeight: 800, letterSpacing: \"-0.5px\" }}>\n              My Applications\n            </Typography>\n            <Typography variant=\"body1\" style={{ color: \"#94a3b8\", marginTop: \"6px\" }}>\n              Track your real-time candidacy progress, submission statuses, and interview invitations.\n            </Typography>\n          </Box>\n\n          {/* List of Applications */}\n          {applications.map((app) => (\n            <Paper key={app._id} className={classes.appCard} elevation={0}>\n              <Grid container spacing={2} alignItems=\"center\">\n                <Grid item xs={12} md={8}>\n                  <Box display=\"flex\" alignItems=\"center\" gap={1.5} mb={0.5}>\n                    <Typography variant=\"h6\" style={{ fontWeight: 700, color: \"#0f172a\" }}>\n                      {app.job?.title || \"Role Unavailable\"}\n                    </Typography>\n                  </Box>\n\n                  <Typography variant=\"subtitle2\" style={{ color: \"#64748b\", fontWeight: 600, marginBottom: \"12px\" }}>\n                    {app.job?.recruiter?.name || \"Direct Partner\"}\n                  </Typography>\n\n                  <Box display=\"flex\" flexWrap=\"wrap\" gap={2} alignItems=\"center\">\n                    <Box display=\"flex\" alignItems=\"center\" gap={0.5} style={{ color: \"#059669\", fontWeight: 700, fontSize: \"0.88rem\" }}>\n                      <MonetizationOnIcon fontSize=\"small\" />\n                      ₹ {app.job?.salary?.toLocaleString() || \"Competitive\"} / mo\n                    </Box>\n                    <Box display=\"flex\" alignItems=\"center\" gap={0.5} style={{ color: \"#64748b\", fontSize: \"0.85rem\" }}>\n                      <AccessTimeIcon fontSize=\"small\" />\n                      Applied on {new Date(app.dateOfApplication).toLocaleDateString()}\n                    </Box>\n                  </Box>\n\n                  {app.sop && (\n                    <Box mt={2} p={1.5} style={{ backgroundColor: \"#f8fafc\", borderRadius: \"8px\", border: \"1px solid #e2e8f0\" }}>\n                      <Typography variant=\"caption\" style={{ color: \"#475569\", display: \"flex\", alignItems: \"center\", gap: \"4px\" }}>\n                        <DescriptionIcon fontSize=\"small\" style={{ fontSize: \"1rem\" }} />\n                        <strong>Submitted SOP:</strong> {app.sop}\n                      </Typography>\n                    </Box>\n                  )}\n                </Grid>\n\n                <Grid item xs={12} md={4} style={{ textAlign: \"right\" }}>\n                  <Box display=\"flex\" flexDirection=\"column\" alignItems={{ xs: \"flex-start\", md: \"flex-end\" }} gap={1}>\n                    {getStatusChip(app.status)}\n                  </Box>\n                </Grid>\n              </Grid>\n            </Paper>\n          ))}\n        </Grid>\n      </Grid>\n    </Box>\n  );\n};\n\nexport default Applications;","C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\recruiter\\MyJobs.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\recruiter\\CreateJobs.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\Profile.js",["106"],"import { useState, useEffect, useContext, useCallback } from \"react\";\nimport {\n  Button,\n  Grid,\n  Typography,\n  Paper,\n  makeStyles,\n  TextField,\n  Avatar,\n  Chip,\n  Box,\n  Divider,\n} from \"@material-ui/core\";\nimport axios from \"axios\";\nimport PersonIcon from \"@material-ui/icons/Person\";\nimport SchoolIcon from \"@material-ui/icons/School\";\nimport WorkIcon from \"@material-ui/icons/Work\";\nimport DescriptionIcon from \"@material-ui/icons/Description\";\nimport SaveIcon from \"@material-ui/icons/Save\";\nimport AddCircleOutlineIcon from \"@material-ui/icons/AddCircleOutline\";\n\nimport { SetPopupContext } from \"../App\";\nimport apiList from \"../lib/apiList\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    backgroundColor: \"#f8fafc\",\n    minHeight: \"100vh\",\n    padding: \"40px 20px 80px 20px\",\n    fontFamily: \"'Inter', sans-serif\",\n  },\n  card: {\n    padding: \"32px\",\n    borderRadius: \"20px\",\n    backgroundColor: \"#ffffff\",\n    border: \"1px solid #e2e8f0\",\n    boxShadow: \"0 10px 30px rgba(0,0,0,0.04)\",\n    marginBottom: \"24px\",\n  },\n  headerAvatar: {\n    width: 72,\n    height: 72,\n    backgroundColor: \"#0f172a\",\n    fontSize: \"1.8rem\",\n    fontWeight: 800,\n    color: \"#10b981\",\n  },\n  sectionTitle: {\n    fontWeight: 800,\n    color: \"#0f172a\",\n    display: \"flex\",\n    alignItems: \"center\",\n    gap: \"10px\",\n    marginBottom: \"20px\",\n  },\n  primaryBtn: {\n    borderRadius: \"12px\",\n    padding: \"12px 28px\",\n    fontWeight: 700,\n    textTransform: \"none\",\n    background: \"linear-gradient(135deg, #0f172a 0%, #1e293b 100%)\",\n    color: \"#ffffff\",\n    boxShadow: \"0 4px 14px rgba(15, 23, 42, 0.25)\",\n    \"&:hover\": {\n      background: \"#2563eb\",\n    },\n  },\n  chipSkill: {\n    margin: \"4px\",\n    fontWeight: 600,\n    backgroundColor: \"#eff6ff\",\n    color: \"#1d4ed8\",\n    border: \"1px solid #bfdbfe\",\n  },\n}));\n\nconst Profile = () => {\n  const classes = useStyles();\n  const setPopup = useContext(SetPopupContext);\n\n  const [profileDetails, setProfileDetails] = useState({\n    name: \"\",\n    education: [{ institutionName: \"\", startYear: \"\", endYear: \"\" }],\n    skills: [],\n    resume: \"\",\n    profile: \"\",\n  });\n\n  const [newSkill, setNewSkill] = useState(\"\");\n\n  const getData = useCallback(() => {\n    axios\n      .get(apiList.user, {\n        headers: {\n          Authorization: `Bearer ${localStorage.getItem(\"token\")}`,\n        },\n      })\n      .then((response) => {\n        setProfileDetails({\n          name: response.data.name || \"\",\n          education:\n            response.data.education && response.data.education.length > 0\n              ? response.data.education\n              : [{ institutionName: \"\", startYear: \"\", endYear: \"\" }],\n          skills: response.data.skills || [],\n          resume: response.data.resume || \"\",\n          profile: response.data.profile || \"\",\n        });\n      })\n      .catch((err) => {\n        setPopup({\n          open: true,\n          severity: \"error\",\n          message: err.response?.data?.message || \"Error fetching profile\",\n        });\n      });\n  }, [setPopup]);\n\n  useEffect(() => {\n    getData();\n  }, [getData]);\n\n  const handleUpdate = () => {\n    axios\n      .put(apiList.user, profileDetails, {\n        headers: {\n          Authorization: `Bearer ${localStorage.getItem(\"token\")}`,\n        },\n      })\n      .then((response) => {\n        setPopup({\n          open: true,\n          severity: \"success\",\n          message: response.data.message || \"Profile updated successfully!\",\n        });\n        getData();\n      })\n      .catch((err) => {\n        setPopup({\n          open: true,\n          severity: \"error\",\n          message: err.response?.data?.message || \"Failed to update profile\",\n        });\n      });\n  };\n\n  const handleAddSkill = () => {\n    if (newSkill.trim() !== \"\" && !profileDetails.skills.includes(newSkill.trim())) {\n      setProfileDetails({\n        ...profileDetails,\n        skills: [...profileDetails.skills, newSkill.trim()],\n      });\n      setNewSkill(\"\");\n    }\n  };\n\n  const handleDeleteSkill = (skillToDelete) => {\n    setProfileDetails({\n      ...profileDetails,\n      skills: profileDetails.skills.filter((s) => s !== skillToDelete),\n    });\n  };\n\n  const handleAddEducation = () => {\n    setProfileDetails({\n      ...profileDetails,\n      education: [\n        ...profileDetails.education,\n        { institutionName: \"\", startYear: \"\", endYear: \"\" },\n      ],\n    });\n  };\n\n  const handleEducationChange = (index, field, value) => {\n    const updatedEdu = [...profileDetails.education];\n    updatedEdu[index][field] = value;\n    setProfileDetails({ ...profileDetails, education: updatedEdu });\n  };\n\n  return (\n    <Box className={classes.root}>\n      <Grid container justify=\"center\">\n        <Grid item xs={11} md={8}>\n          {/* Top Header Card */}\n          <Paper className={classes.card} elevation={0}>\n            <Box display=\"flex\" alignItems=\"center\" gap={3} flexWrap=\"wrap\">\n              <Avatar className={classes.headerAvatar}>\n                {profileDetails.name ? profileDetails.name.charAt(0).toUpperCase() : <PersonIcon />}\n              </Avatar>\n              <Box flex={1}>\n                <Typography variant=\"h5\" style={{ fontWeight: 800, color: \"#0f172a\" }}>\n                  {profileDetails.name || \"Candidate Profile\"}\n                </Typography>\n                <Typography variant=\"body2\" style={{ color: \"#64748b\", marginTop: \"4px\" }}>\n                  Early-Career Candidate • InternBridge Verified Hub\n                </Typography>\n              </Box>\n              <Button\n                variant=\"contained\"\n                className={classes.primaryBtn}\n                startIcon={<SaveIcon />}\n                onClick={handleUpdate}\n              >\n                Save Changes\n              </Button>\n            </Box>\n          </Paper>\n\n          {/* Basic Details */}\n          <Paper className={classes.card} elevation={0}>\n            <Typography variant=\"h6\" className={classes.sectionTitle}>\n              <PersonIcon style={{ color: \"#2563eb\" }} /> Personal Information\n            </Typography>\n            <Grid container spacing={3}>\n              <Grid item xs={12} sm={6}>\n                <TextField\n                  label=\"Full Name\"\n                  variant=\"outlined\"\n                  fullWidth\n                  value={profileDetails.name}\n                  onChange={(e) =>\n                    setProfileDetails({ ...profileDetails, name: e.target.value })\n                  }\n                />\n              </Grid>\n              <Grid item xs={12} sm={6}>\n                <TextField\n                  label=\"Resume / Portfolio Link (Google Drive / GitHub)\"\n                  variant=\"outlined\"\n                  fullWidth\n                  value={profileDetails.resume}\n                  onChange={(e) =>\n                    setProfileDetails({ ...profileDetails, resume: e.target.value })\n                  }\n                />\n              </Grid>\n            </Grid>\n          </Paper>\n\n          {/* Education Timeline */}\n          <Paper className={classes.card} elevation={0}>\n            <Box display=\"flex\" justifyContent=\"space-between\" alignItems=\"center\" mb={2}>\n              <Typography variant=\"h6\" className={classes.sectionTitle} style={{ marginBottom: 0 }}>\n                <SchoolIcon style={{ color: \"#10b981\" }} /> Education & Qualifications\n              </Typography>\n              <Button\n                size=\"small\"\n                startIcon={<AddCircleOutlineIcon />}\n                onClick={handleAddEducation}\n                style={{ fontWeight: 700, textTransform: \"none\", color: \"#10b981\" }}\n              >\n                Add Institution\n              </Button>\n            </Box>\n            <Divider style={{ marginBottom: \"20px\" }} />\n\n            {profileDetails.education.map((edu, idx) => (\n              <Grid container spacing={2} key={idx} style={{ marginBottom: \"16px\" }}>\n                <Grid item xs={12} sm={6}>\n                  <TextField\n                    label={`Institution #${idx + 1}`}\n                    variant=\"outlined\"\n                    fullWidth\n                    value={edu.institutionName}\n                    onChange={(e) =>\n                      handleEducationChange(idx, \"institutionName\", e.target.value)\n                    }\n                  />\n                </Grid>\n                <Grid item xs={6} sm={3}>\n                  <TextField\n                    label=\"Start Year\"\n                    variant=\"outlined\"\n                    type=\"number\"\n                    fullWidth\n                    value={edu.startYear}\n                    onChange={(e) =>\n                      handleEducationChange(idx, \"startYear\", e.target.value)\n                    }\n                  />\n                </Grid>\n                <Grid item xs={6} sm={3}>\n                  <TextField\n                    label=\"End Year\"\n                    variant=\"outlined\"\n                    type=\"number\"\n                    fullWidth\n                    value={edu.endYear}\n                    onChange={(e) =>\n                      handleEducationChange(idx, \"endYear\", e.target.value)\n                    }\n                  />\n                </Grid>\n              </Grid>\n            ))}\n          </Paper>\n\n          {/* Skills Hub */}\n          <Paper className={classes.card} elevation={0}>\n            <Typography variant=\"h6\" className={classes.sectionTitle}>\n              <WorkIcon style={{ color: \"#f59e0b\" }} /> Core Skillsets & Disciplines\n            </Typography>\n            <Box display=\"flex\" gap={2} mb={2} flexWrap=\"wrap\">\n              <TextField\n                label=\"Add Skill (e.g., Python, Strategy, SQL, Financial Modeling)\"\n                variant=\"outlined\"\n                size=\"small\"\n                style={{ flex: 1, minWidth: \"240px\" }}\n                value={newSkill}\n                onChange={(e) => setNewSkill(e.target.value)}\n                onKeyPress={(e) => e.key === \"Enter\" && handleAddSkill()}\n              />\n              <Button\n                variant=\"contained\"\n                onClick={handleAddSkill}\n                style={{\n                  backgroundColor: \"#0f172a\",\n                  color: \"#fff\",\n                  fontWeight: 700,\n                  textTransform: \"none\",\n                  borderRadius: \"10px\",\n                }}\n              >\n                Add\n              </Button>\n            </Box>\n\n            <Box display=\"flex\" flexWrap=\"wrap\" mt={2}>\n              {profileDetails.skills.map((skill, index) => (\n                <Chip\n                  key={index}\n                  label={skill}\n                  onDelete={() => handleDeleteSkill(skill)}\n                  className={classes.chipSkill}\n                />\n              ))}\n            </Box>\n          </Paper>\n        </Grid>\n      </Grid>\n    </Box>\n  );\n};\n\nexport default Profile;","C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\recruiter\\AcceptedApplicants.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\lib\\isAuth.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\recruiter\\JobApplications.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\component\\recruiter\\Profile.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\lib\\MessagePopup.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\lib\\apiList.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\lib\\PasswordInput.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\lib\\EmailInput.js",[],"C:\\Users\\aryan\\OneDrive\\Desktop\\internship portal\\job-portal-main\\frontend\\src\\lib\\FileUploadInput.js",[],["107","108"],{"ruleId":"109","replacedBy":"110"},{"ruleId":"111","replacedBy":"112"},{"ruleId":"113","severity":1,"message":"114","line":16,"column":6,"nodeType":"115","endLine":16,"endColumn":8,"suggestions":"116"},{"ruleId":"109","replacedBy":"117"},{"ruleId":"111","replacedBy":"118"},{"ruleId":"119","severity":1,"message":"120","line":3,"column":3,"nodeType":"121","messageId":"122","endLine":3,"endColumn":9},{"ruleId":"119","severity":1,"message":"123","line":10,"column":3,"nodeType":"121","messageId":"122","endLine":10,"endColumn":9},{"ruleId":"119","severity":1,"message":"124","line":11,"column":3,"nodeType":"121","messageId":"122","endLine":11,"endColumn":10},{"ruleId":"119","severity":1,"message":"125","line":14,"column":8,"nodeType":"121","messageId":"122","endLine":14,"endColumn":26},{"ruleId":"119","sever